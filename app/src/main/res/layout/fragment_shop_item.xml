<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <variable
            name="viewModel"
            type="com.five9th.shoppinglistapp.presentation.ShopItemViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.ShopItemFragment">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/item_name_til"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="3dp"
            android:hint="@string/name_hint"

            android:inputType="textCapWords"
            app:layout_constraintBottom_toTopOf="@id/item_count_til"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"

            app:nameHasError="@{viewModel.nameHasError}">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/item_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="@{viewModel.shopItemLD.name}"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/item_count_til"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="3dp"

            android:hint="@string/count_hint"
            app:layout_constraintBottom_toTopOf="@id/save_btn"
            app:layout_constraintTop_toBottomOf="@id/item_name_til"

            app:countHasError="@{viewModel.countHasError}">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/item_count_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                tools:text="2"

                app:numberAsText="@{viewModel.shopItemLD.count}"/>

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/save_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"

            android:text="@string/save_btn_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>